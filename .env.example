# Cleanzo Frontend Environment Variables Example
# NOTE: All NEXT_PUBLIC_* variables must be available at BUILD time.

# In Local Development: http://localhost:5000/api
# In Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend Base URL (used by next.config.ts rewrites for /uploads)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Frontend Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

