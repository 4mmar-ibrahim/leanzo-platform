# Cleanzo Frontend Environment Variables Example
# Required for connecting frontend to backend

# In Local Development: http://localhost:5000/api
# In Production (Vercel): https://api.yourdomain.com/api (pointing to Contabo/VPS backend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Frontend Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
