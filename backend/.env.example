# Cleanzo Backend Environment Variables Template
NODE_ENV=production
PORT=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# Auth Secrets & Expiration (use four distinct random secrets)
# DATA_ENCRYPTION_KEY must match the existing key for encrypted records.
DATA_ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_JWT_SECRET=
CUSTOMER_REFRESH_SECRET=
ADMIN_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Initial Admin Bootstrap (Used once at initial startup if no admin exists)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_PHONE=01000000000

# Client & API Configuration
CLIENT_URL=https://yourdomain.com
API_PREFIX=/api


# Optional additional frontend origins, comma-separated.
CORS_ALLOWED_ORIGINS=
