# Cleanzo Backend Environment Variables Template
NODE_ENV=production
PORT=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# Auth Secrets & Expiration
JWT_SECRET=your_strong_random_jwt_secret_here
ADMIN_JWT_SECRET=your_strong_random_admin_jwt_secret_here
CUSTOMER_REFRESH_SECRET=your_strong_random_customer_refresh_secret_here
ADMIN_REFRESH_SECRET=your_strong_random_admin_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Initial Admin Bootstrap (Used once at initial startup if no admin exists)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=your_secure_bootstrap_password
ADMIN_BOOTSTRAP_PHONE=01000000000

# Client & API Configuration
CLIENT_URL=https://yourdomain.com
API_PREFIX=/api

