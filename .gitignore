# Cleanzo Production .gitignore
# ============================================

# 1. Dependencies (Root & Backend)
node_modules/
*/node_modules/
backend/node_modules/
.pnp
.pnp.js

# 2. Environment Variables (Strictly Private - NEVER Commit)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# 3. Next.js & Frontend Build Outputs
.next/
out/
build/

# 4. Backend Build & Output
backend/dist/
dist/

# 5. Dynamic User Uploads (Empty directories preserved via .gitkeep)
uploads/images/*
!uploads/images/.gitkeep
uploads/videos/*
!uploads/videos/.gitkeep
backend/uploads/images/*
!backend/uploads/images/.gitkeep
backend/uploads/videos/*
!backend/uploads/videos/.gitkeep

# 6. Storage & Backups
backend/storage/backups/*
!backend/storage/backups/.gitkeep
backend/storage/temp/*
!backend/storage/temp/.gitkeep

# 7. Vercel & Deployment Caches
.vercel/

# 8. Testing & Coverage
coverage/
.nyc_output/

# 9. Logs & Runtime Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 10. OS & Editor Specific
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo
next-env.d.ts
